{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/join-room/src/(.*)",
      "destination": "/src/$1"
    },
    {
      "source": "/join-room/(.*)",
      "destination": "/index.html"
    }
  ]
}
