# ==============================================================================
# Settle Up - Environment Configuration Template
# Copy this file to '.env' for local development.
# Configure corresponding variables in the Vercel Dashboard for production.
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
# For local development: 'development' (uses SQLite & local file storage)
# For Vercel production: 'production' (strictly enforces PostgreSQL & cloud storage)
FLASK_ENV=development

# Debug Mode: True for local development, False in production
FLASK_DEBUG=True

# Server Network Binding (local dev)
HOST=127.0.0.1
PORT=5000

# Cryptographic Secret Key for session & token signatures
# Local development can use the placeholder below.
# Production REQUIRES a cryptographically strong random 64-character hex key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=settleup-dev-secret-key-change-for-production

# Cross-Origin Resource Sharing (CORS)
# Local development: *
# Production: your production frontend domain (e.g., https://your-project.vercel.app)
CORS_ORIGINS=*

# Database Connection URI
# Local development: SQLite (default file-based in project root)
DATABASE_URL=sqlite:///settleup.db

# Production Database (Required on Vercel):
# Set DATABASE_URL to your PostgreSQL connection string (Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/neondb?sslmode=require

# Database Auto-Initialization (set to False if running pre-deployment schema migrations)
AUTO_INIT_DB=True

# Seed Sample Data in Production: False (default) prevents creating GOA2026 trip on fresh production DB
# Set to True if you want the sample Goa vacation room auto-populated in production
SEED_SAMPLE_DATA=False

# Payment Proof Storage Configuration
# Local development: 'local' (saves to UPLOAD_FOLDER on local disk)
# Production on Vercel: 's3', 'cloudinary', or 'vercel_blob' (required - local disk is ephemeral)
STORAGE_PROVIDER=local

# Local File Storage Directory (used when STORAGE_PROVIDER=local)
UPLOAD_FOLDER=uploads/proofs

# ==============================================================================
# PRODUCTION CLOUD STORAGE PROVIDERS (Configure ONE for Vercel deployment)
# ==============================================================================

# Option A: AWS S3 or S3-Compatible (Cloudflare R2, MinIO, Supabase Storage)
# STORAGE_PROVIDER=s3
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  # Optional (Cloudflare R2 / MinIO)
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com                          # Optional custom domain

# Option B: Cloudinary Storage
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_UPLOAD_PRESET=settleup_proofs                          # Optional (for unsigned uploads)

# Option C: Vercel Blob Storage
# STORAGE_PROVIDER=vercel_blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Reverse Proxy Header Handling (handles HTTPS X-Forwarded-Proto on Vercel/proxies)
USE_PROXY_FIX=True
