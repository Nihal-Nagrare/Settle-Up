# ==============================================================================
# Settle Up - Environment Configuration Template
# Copy this file to '.env' and customize for your local or production environment.
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
FLASK_ENV=production

# Debug Mode: ALWAYS 'False' in production
FLASK_DEBUG=False

# Server Network Binding
HOST=0.0.0.0
PORT=5000

# Cryptographic Secret Key for session & token signatures
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# Cross-Origin Resource Sharing (CORS)
# In production, specify your frontend domain (e.g. https://settleup.yourdomain.com)
CORS_ORIGINS=https://settleup.yourdomain.com

# Database Connection URI
# SQLite (default file-based): sqlite:///settleup.db
# PostgreSQL (production recommended): postgresql://dbuser:dbpassword@dbhost:5432/settleup
DATABASE_URL=sqlite:///settleup.db

# Payment Proof Upload Directory
UPLOAD_FOLDER=uploads/proofs

# Enable Reverse Proxy Header Handling (HTTPS detection & client IP tracking)
USE_PROXY_FIX=True
